# ==============================
# AI Data Profiler - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================

# --- Database ---
DATABASE_URL=postgresql://profiler:profiler@localhost:5432/ai_data_profiler

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OpenAI (LLM insights) ---
# If unset, AI insight generation falls back to a deterministic
# rules-based summary so the product still works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# --- Razorpay (future, India) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- File handling ---
UPLOAD_DIR=/tmp/ai-data-profiler-uploads
MAX_UPLOAD_MB_FREE=10
MAX_UPLOAD_MB_PRO=100
MAX_UPLOAD_MB_TEAM=500
FILE_RETENTION_HOURS=24

# --- Plan limits (also editable via DB `plans` table at runtime) ---
FREE_ANALYSES_PER_MONTH=3
PRO_ANALYSES_PER_MONTH=50
TEAM_ANALYSES_PER_MONTH=500
PRO_PRICE_INR=499
TEAM_PRICE_INR=1999

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Background scheduler (polls ScheduledAnalysis rows in-process) ---
# Set to false on all but one instance if you ever scale the backend to
# multiple replicas, to avoid double-running the same due schedule.
ENABLE_SCHEDULER=true
SCHEDULER_POLL_SECONDS=60
