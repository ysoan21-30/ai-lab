# Copy this file to .env and fill in your key.
# The Claude Agent SDK reads ANTHROPIC_API_KEY from the environment.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model tiers used by the router (see config.py for defaults)
MODEL_TIER_FAST=claude-haiku-4-5
MODEL_TIER_BALANCED=claude-sonnet-4-5
MODEL_TIER_DEEP=claude-opus-4-1

# Required for the RAG tools (retrieve_docs, scrape_page, crawl_site).
# Get a key at https://dash.voyageai.com/
VOYAGE_API_KEY=pa-your-voyage-key-here
VOYAGE_EMBED_MODEL=voyage-3.5

# Optional: RAG store + crawler tuning (see config.py for defaults)
RAG_DB_DIR=./rag_store
RAG_COLLECTION=docs
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200
CRAWL_MAX_PAGES=20
CRAWL_MAX_DEPTH=2

# Optional: data-science tool sandbox (load_dataset, python_exec)
AGENT_WORKSPACE_DIR=./workspace
DS_EXEC_TIMEOUT_SECONDS=30
